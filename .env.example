# ─── BizSwipe Backend — Environment Variables ────────────────────────────────
# Yeh file .gitignore mein daalo — GitHub pe kabhi push mat karo!

# ── Setu.co Credentials ───────────────────────────────────────────────────────
# setu.co → Dashboard → Data Gateway → GST Verification → Credentials
SETU_CLIENT_ID=yahan-apna-client-id-daalo
SETU_CLIENT_SECRET=yahan-apna-client-secret-daalo
SETU_PRODUCT_INSTANCE_ID=yahan-apna-product-instance-id-daalo

# ── Environment ───────────────────────────────────────────────────────────────
# Testing ke liye: development
# Live ke liye: production
NODE_ENV=development

# ── Server Port ───────────────────────────────────────────────────────────────
PORT=3000
